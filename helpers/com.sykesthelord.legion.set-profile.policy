<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>

  <vendor>Legion Control Center</vendor>

  <!--
    Lets the person logged in at the laptop switch power profiles without a
    password, but only through the root-owned helper below, which accepts
    nothing except a profile name. Remote and inactive sessions still need
    an administrator password.
  -->
  <action id="com.sykesthelord.legion.set-profile">
    <description>Switch the Lenovo Legion power profile</description>
    <message>Authentication is required to switch the power profile</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/legion-set-profile</annotate>
  </action>

</policyconfig>
